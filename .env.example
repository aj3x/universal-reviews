# Copy to .env and fill in. Never commit .env.

# NODE_ENV=production is set by the Docker image. In production PUBLIC_URL is required and must be https
# (localhost excepted); the API refuses to start on a bad configuration and says why.
# PORT=8080
# DATABASE_PATH=./data/rating.db

# Public URL the browser uses (Google redirects back to $PUBLIC_URL/api/v1/auth/google/callback)
PUBLIC_URL=http://localhost:8080
# Where to send people after sign-in (the PWA). Defaults to PUBLIC_URL.
APP_URL=http://localhost:5173

# Google sign-in: Google Cloud Console > APIs & Services > Credentials > OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Places API (New). Restrict the key to the Places API; cap quotas at the free amounts.
GOOGLE_PLACES_API_KEY=

# TMDB (movies): themoviedb.org > Settings > API, the v3 API key. Free for non-commercial use.
TMDB_API_KEY=

# Optional invite list. Empty = anyone with a Google account can sign up.
ALLOWED_EMAILS=

# Local only: enables POST /api/v1/auth/dev-login {"email": "..."}. Ignored when NODE_ENV=production.
DEV_LOGIN=0

# Cloudflare Tunnel (docker compose --profile tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# Litestream backups to R2 (docker compose --profile backup)
R2_ACCOUNT_ID=
LITESTREAM_BUCKET=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
